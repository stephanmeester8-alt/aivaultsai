# AIVaultsAI — web (apps/web)
# Kopieer naar .env.local en vul de echte waarden in. Niets hiervan mag
# met echte waarden in git terechtkomen.

# --- Database (Neon PostgreSQL, server-only) ---
# Bestaand: wordt ook door alle overige pagina's en API's gebruikt.
DATABASE_URL=postgresql://user:password@host/database

# --- Tenant (Sprint 3, server-only, optioneel) ---
# Site-tenant voor de publieke website (assistant/leads/booking). Eén centrale
# resolutie via lib/tenancy.ts. Zonder deze variabele wordt de deterministische
# default-tenant (migratie 011-seed) gebruikt — alleen overschrijven wanneer een
# omgeving expliciet een eigen tenant moet hebben.
# TENANT_ID=11111111-1111-4111-8111-111111111111

# --- Lead notificaties (Resend, server-only) ---
# API key uit https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Afzender moet geverifieerd zijn in Resend (bijv. noreply@aivaultsai.one) —
# wijzig niet blind; alleen een geverifieerde afzender bezorgt e-mail.
LEAD_FROM_EMAIL=noreply@example.com
# Officieel ontvangstadres voor lead-notificaties (websiteformulier én
# AI-assistent-leads). Productie: info@aivaultsai.nl
LEAD_NOTIFICATION_EMAIL=info@aivaultsai.nl

# --- Optioneel ---
# GA4 meting (zonder dit: analytics volledig uit)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Webshop redirect-basis (alleen voor preview-omgevingen; productie gebruikt de site-URL)
# SHOP_BASE_URL=https://preview.example.com
